#!/usr/bin/python3
"""Hold a sandbox-local process lease and record confirmed native agent exit."""
import base64
import fcntl
import json
import os
import pathlib
import subprocess
import sys
import time

control = pathlib.Path(os.environ.get('PADDOCK_CONTROL_DIR', '/sandbox'))
lock = open(control / 'agent.lock', 'a')
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit('A native agent is already running in this task sandbox.')

# OpenShell substitutes only opaque provider references at allowed endpoints.
# Codex parses id_token locally; the unsigned local metadata is not a credential.
if pathlib.Path(sys.argv[2]).name == 'codex' and os.environ.get('CODEX_AUTH_ACCESS_TOKEN'):
    encode = lambda v: base64.urlsafe_b64encode(json.dumps(v).encode()).decode().rstrip('=')
    identity = '.'.join([encode({'alg': 'none', 'typ': 'JWT'}), encode({
        'iss': 'https://auth.openai.com', 'aud': 'codex', 'sub': 'paddock-sandbox',
        'email': 'agent@paddock.local', 'https://api.openai.com/auth': {'chatgpt_account_id': os.environ.get('CODEX_ACCOUNT_ID', '')}, 'iat': int(time.time()), 'exp': int(time.time()) + 3600,
    }), 'placeholder'])
    home = pathlib.Path(os.environ['CODEX_HOME'])
    home.mkdir(mode=0o700, parents=True, exist_ok=True)
    auth = home / 'auth.json'
    auth.write_text(json.dumps({'auth_mode': 'chatgptAuthTokens', 'OPENAI_API_KEY': None,
        'tokens': {'id_token': identity, 'access_token': os.environ['CODEX_AUTH_ACCESS_TOKEN'],
                   'refresh_token': '', 'account_id': os.environ.get('CODEX_ACCOUNT_ID') or os.environ.get('CODEX_AUTH_ACCOUNT_ID', '')},
        'last_refresh': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}))
    auth.chmod(0o600)

# Start the native shared owner explicitly. On minimal containers the TUI can
# otherwise fall back to an in-process server while `codex queue` uses another.
if pathlib.Path(sys.argv[2]).name == 'codex':
    result = subprocess.run([sys.argv[2], 'app-server', 'daemon', 'start'], stdout=subprocess.DEVNULL)
    if result.returncode:
        sys.exit('Could not start the native Codex session server.')
    if 'resume' in sys.argv[3:]:
        index = sys.argv.index('resume', 3)
        result = subprocess.run(['/usr/local/bin/paddock-codex-state', 'resume', sys.argv[index + 1]])
        if result.returncode:
            sys.exit('Could not restore the native conversation in the OpenShell runtime.')

gateway = None
if os.environ.get('PADDOCK_IDLE_TTL') and pathlib.Path(sys.argv[2]).name == 'codex':
    gateway = subprocess.Popen(['/usr/local/bin/paddock-idle', 'serve', sys.argv[1]],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    ready = control / 'idle-ready.json'
    deadline = time.monotonic() + 10
    while True:
        try:
            if json.loads(ready.read_text())['generation'] == int(sys.argv[1]):
                break
        except (OSError, ValueError, KeyError):
            pass
        if gateway.poll() is not None or time.monotonic() > deadline:
            if gateway.poll() is None:
                gateway.terminate()
                gateway.wait()
            sys.exit('Idle TTL requires a verified native admission fence; rebuild the runtime image or inspect kernel support.')
        time.sleep(0.05)

marker = control / 'agent-exit.json'
marker.unlink(missing_ok=True)
agent_args = sys.argv[2:]
claude = pathlib.Path(sys.argv[2]).name == 'claude'
if claude:
    version = subprocess.check_output([sys.argv[2], '--version'], text=True).strip()
    if version != '2.1.286 (Claude Code)':
        sys.exit('Claude inbox delivery requires qualified Claude Code 2.1.286.')
    inbox = pathlib.Path(os.environ.get('CLAUDE_CONFIG_DIR', '/home/sandbox/.claude')) / 'paddock-inbox.sock'
    agent_args = [sys.argv[2], '--messaging-socket-path', str(inbox)] + sys.argv[3:]
# The child owns native approvals and turn completion; never infer idle from PTY output.
child = subprocess.Popen(agent_args)
if claude:
    flag = '--resume' if '--resume' in agent_args else '--session-id'
    session = agent_args[agent_args.index(flag) + 1]
    state = control / 'claude-process.json'
    state.write_text(json.dumps({'pid': child.pid, 'conversation': session,
                                'generation': int(sys.argv[1])}))
    state.chmod(0o600)
frontend_stopped = False
while True:
    try:
        code = child.wait(timeout=0.2 if gateway else None)
        if gateway:
            # Native drain may disconnect the TUI before owner cleanup finishes.
            # Keep the process lease until the pinned owner actually exits.
            while (control / 'idle-drain.json').exists() and not (control / 'idle-stopped.json').exists():
                if gateway.poll() is not None:
                    sys.exit('Native idle drain is unconfirmed; sandbox retained.')
                time.sleep(0.1)
            if (control / 'idle-stopped.json').exists():
                code = 0
        break
    except subprocess.TimeoutExpired:
        if gateway and not frontend_stopped and (control / 'idle-stopped.json').exists():
            # The model runtime has exited behind a closed admission gate. This
            # terminates only its disconnected TUI frontend, never model work.
            child.terminate()
            frontend_stopped = True
        continue
    except KeyboardInterrupt:
        # The foreground process group receives the same interrupt.
        continue
if gateway:
    gateway.terminate()
    gateway.wait()
partial = marker.with_suffix('.tmp')
partial.write_text(json.dumps({'generation': int(sys.argv[1]), 'code': code}))
partial.replace(marker)
sys.exit(code if code >= 0 else 128 - code)
