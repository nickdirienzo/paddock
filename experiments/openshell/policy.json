{
  "version": 1,
  "filesystem_policy": {
    "include_workdir": true,
    "read_only": [
      "/usr",
      "/lib",
      "/etc",
      "/proc",
      "/dev/urandom"
    ],
    "read_write": [
      "/tmp",
      "/dev/null",
      "/home/sandbox",
      "/sandbox"
    ]
  },
  "landlock": {
    "compatibility": "hard_requirement"
  },
  "network_policies": {
    "go_modules": {
      "name": "go_modules",
      "endpoints": [
        {
          "host": "proxy.golang.org",
          "port": 443,
          "protocol": "rest",
          "access": "read-only",
          "enforcement": "enforce"
        },
        {
          "host": "sum.golang.org",
          "port": 443,
          "protocol": "rest",
          "access": "read-only",
          "enforcement": "enforce"
        },
        {
          "host": "storage.googleapis.com",
          "port": 443,
          "protocol": "rest",
          "access": "read-only",
          "enforcement": "enforce"
        }
      ],
      "binaries": [
        {
          "path": "/usr/local/go/bin/go"
        }
      ]
    }
  }
}