{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paddock:access:wire:v1",
  "title": "Paddock access wire v1",
  "schema_version": 1,
  "protocol_version": 1,
  "description": "Network access protocol v1. Immutable snapshots disclose the complete reviewed network rule; Paddock retains private review tokens. Decisions and notifications are separately durable.",
  "commands": {
    "list": "paddock access list --task TASK --status all --refresh --json",
    "show": "paddock access show REQUEST --task TASK --refresh --json",
    "decide": "paddock access decide REQUEST --decision-file FILE --json",
    "reconcile": "paddock access reconcile REQUEST --task TASK --json"
  },
  "semantics": {
    "inspection": "Never grants, sends notification, resumes compute, or refreshes token for an admitted decision. --refresh reads authoritative backend; failures explicit.",
    "reconcile": "Observes/reconciles existing durable decision and retries only definitely-unsent notification. Never resubmits uncertain upstream mutations. For a known request, a validated task ledger inspected under its operation lease may prove no decision intent exists: return error.code=no_decision, retryable=true, receipt=null. The caller may resubmit the exact frozen decision input/external ID. Missing/corrupt/unknown state or any existing historical/accepted intent must not return no_decision. This does not assert absence of out-of-band upstream access changes.",
    "reject": "Pinned OpenShell 0.1.6 reject can revoke approved rules. Production adapter advertises unavailable and never calls it. current_pending_request may only be advertised by a separately qualified backend with an atomic pending-only transition.",
    "idempotency": "Authenticated OS caller + task_id + external_id, bound to the entire input and request ID; replay returns same decision ID/current receipt.",
    "exits": "0 on successful command/confirmed or still-pending receipt without error; nonzero with structured error. A nonzero exit does not imply no side effect; receipt remains present after admission.",
    "notification": "Paddock exclusively owns continuation. delivered means native enqueue, not task completion.",
    "revision": "Opaque sha256 of complete stored immutable snapshot including full rule, target identity and upstream review-token digest. Never calculate from display text.",
    "legacy": "Operator pending/show/approve/reject syntax remains; legacy unbound show keeps old shape. --task selects wire-v1 show. Both operator and integration decisions use one executor.",
    "backend_qualification": "The pinned adapter supports exact_reviewed_rule for qualified credential-free inspected REST AddRules using the captured upstream token and immutable sandbox ID. It does not atomically fence independently administered provider/global context or the displayed complete candidate-policy evaluation. Full evaluated-context approval still requires upstream mutation guard/CAS. Native reject remains unavailable.",
    "advisor": "available means the effective advisor setting was observed enabled, not a live end-to-end guide/submission probe. Existing proposals may be reviewed independently of advisor setting.",
    "examples": "Synthetic network-only examples show the qualified exact_reviewed_rule path. Other rules remain individually nonactionable; example revisions are opaque illustrative values.",
    "network_approval": "exact_reviewed_rule applies the captured credential-free REST AddRule to the same immutable sandbox using its original review token. Independent administrator provider/global-policy changes remain independent; the complete effective policy is not frozen.",
    "integration_results": "The integration_results feature identifies server-qualified supported_decisions, complete plain-text review text, and normalized decision outcomes. Integrations validate identity and freshness, render review unchanged, and use outcome.state for recovery instead of reinterpreting backend substates."
  },
  "$defs": {
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
